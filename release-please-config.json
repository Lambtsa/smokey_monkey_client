{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "node",
      "include-component-in-tag": false,
      "include-v-in-tag": true,
      "draft": true,
      "force-tag-creation": true,
      "changelog-sections": [
        { "type": "feat", "section": "🚀 Features" },
        { "type": "feature", "section": "🚀 Features" },
        { "type": "fix", "section": "🐛 Fixes" },
        { "type": "refactor", "section": "♻️ Refactoring & Performance" },
        { "type": "perf", "section": "♻️ Refactoring & Performance" },
        { "type": "style", "section": "♻️ Refactoring & Performance" },
        { "type": "chore", "section": "🧹 Chores & Maintenance" },
        { "type": "ci", "section": "🧹 Chores & Maintenance" },
        { "type": "build", "section": "🧹 Chores & Maintenance" },
        { "type": "test", "section": "🧹 Chores & Maintenance" },
        { "type": "revert", "section": "🧹 Chores & Maintenance" }
      ]
    }
  }
}
